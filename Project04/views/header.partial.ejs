<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles/styles.css" />
</head>
<body>
    
<header>
  <div class="header-auth">
    <% if (locals.user) { %>
      <span>Zalogowany jako: <strong><%= locals.user.username %></strong></span>
      <a href="/auth/logout">Wyloguj się</a>
    <% } else { %>
      <a href="/auth/login">Zaloguj się</a> 
      lub
      <a href="/auth/signup">Zarejestruj się</a>
    <% } %>
  </div>
</header>
